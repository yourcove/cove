---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import MarketingShot from '../components/MarketingShot.astro';
import { withBase } from '../lib/paths';

const faqStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is a local media organizer?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'A local media organizer helps you keep a media library on hardware you control, then search it, browse it, tag it, and share it on your own terms.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can Cove organize more than video?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. Cove can organize videos, images, galleries, audio, and text in one library, then connect them with tags, people, groups, studios, and other details.',
        },
      },
      {
        '@type': 'Question',
        name: 'Do I need a cloud account to use Cove?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. Cove is meant to run where you install it, and it does not require a cloud account between you and your own library.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can I share a Cove library with other people?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. Cove supports separate users, roles, permissions, and share links, so everyone on your network can have their own account instead of sharing one login.',
        },
      },
    ],
  },
];
---

<MarketingLayout
  title="Local Media Organizer"
  description="Cove is a local media organizer for private libraries, shared households, and people who want more than folders and filenames."
  imagePath="/images/screenshots/dashboard-home.png"
  extraStructuredData={faqStructuredData}
>
  <section class="marketing-section">
    <div class="marketing-section-inner two-column">
      <div>
        <p class="eyebrow-small">Local media organizer</p>
        <h1 class="page-heading">Why keep your media library local?</h1>
        <p class="lead">
          Because it's yours. Cove gives a folder of files the things you'd expect from a streaming app, like search, tags, history, and good browsing, without moving anything off your own hardware.
        </p>
        <div class="button-row">
          <a class="button" href={withBase('download/')}>Download Cove</a>
          <a class="button-ghost" href={withBase('features/')}>Explore features</a>
        </div>
      </div>
      <MarketingShot
        src={withBase('images/screenshots/dashboard-home.png')}
        alt="Cove home dashboard showing a local media library."
        caption="A local library with real search, browsing, and return-to-what-you-were-doing tools."
      />
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner info-grid">
      <article class="info-card">
        <h3>Private by default</h3>
        <p>Your media, previews, metadata, and accounts stay on the machine you choose. Nothing goes anywhere unless you turn on an outside service yourself.</p>
      </article>
      <article class="info-card">
        <h3>More than filenames</h3>
        <p>Search by people, tags, groups, studios, and titles instead of relying on folder names and memory.</p>
      </article>
      <article class="info-card">
        <h3>Made for everyday use</h3>
        <p>Browse in a grid, feed, or vertical page, keep watch history and save-for-later lists, and share with the people on your network.</p>
      </article>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner two-column">
      <MarketingShot
        src={withBase('images/screenshots/audio-detail.png')}
        alt="Cove audio detail page connected to a local media library."
        caption="One library can keep videos, images, galleries, audio, and text together."
      />
      <div class="panel">
        <p class="section-kicker">Keep more in one place</p>
        <h2 class="section-heading">One organizer for the media you already have</h2>
        <p class="page-copy">
          Cove isn't only for video. Videos, images, galleries, audio, and text live in one library, connected by people, tags, groups, studios, and your own notes, which makes the whole thing easier to search and easier to understand.
        </p>
        <ul class="check-list">
          <li>Different kinds of media in one local library.</li>
          <li>Related items stay connected instead of scattered across apps.</li>
          <li>The details that help you find things later actually get kept.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner two-column">
      <div class="panel">
        <p class="section-kicker">When folders stop being enough</p>
        <h2 class="section-heading">Built for the point where the library gets big</h2>
        <p class="page-copy">
          Folder organization works until it doesn't. Once a library is large, shared, or hard to search, Cove's global search, saved filters, tagging, groups, and segments are what keep it usable.
        </p>
        <ul class="check-list">
          <li>Jump to matching videos, people, tags, and groups from global search.</li>
          <li>Save the searches you come back to.</li>
          <li>Give each person their own account instead of sharing one login.</li>
        </ul>
      </div>
      <MarketingShot
        src={withBase('images/screenshots/global-search.png')}
        alt="Cove global search for a local media library."
        caption="Global search gives a growing library a faster front door."
      />
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner">
      <p class="section-kicker">Common questions</p>
      <div class="feature-grid">
        <article class="feature-card">
          <h3>What is a local media organizer?</h3>
          <p>Software that keeps a media library on your own hardware and lets you search, browse, tag, and share it on your own terms.</p>
        </article>
        <article class="feature-card">
          <h3>Can Cove organize more than video?</h3>
          <p>Yes. One Cove library can hold videos, images, galleries, audio, and text together.</p>
        </article>
        <article class="feature-card">
          <h3>Do I need a cloud account?</h3>
          <p>No. Cove runs locally and never asks you to create an account with anyone.</p>
        </article>
        <article class="feature-card">
          <h3>Can I share a library?</h3>
          <p>Yes. Users, roles, permissions, and share links let you share within your network safely.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner doc-split-grid">
      <article class="doc-track-card">
        <h3>See how Cove works</h3>
        <p>Browse the feature tour to see search, tagging, feed browsing, permissions, and extensions in the actual app.</p>
        <a class="button-ghost" href={withBase('features/')}>Open the feature tour</a>
      </article>
      <article class="doc-track-card">
        <h3>Ready to install it?</h3>
        <p>Start with the download page, then follow Get Started through first-run setup, your first scan, and a short library tour.</p>
        <a class="button-ghost" href={withBase('download/')}>Go to download</a>
      </article>
      <article class="doc-track-card">
        <h3>Want more direct answers?</h3>
        <p>Read the FAQ for straightforward answers about privacy, sharing, library fit, and more specific use cases.</p>
        <a class="button-ghost" href={withBase('faq/')}>Open FAQ</a>
      </article>
    </div>
  </section>
</MarketingLayout>
