---
import {
  DEFAULT_OG_IMAGE,
  SITE_DESCRIPTION,
  SITE_NAME,
  getAbsoluteUrl,
  getMarketingPageSchemas,
} from '../lib/seo';
import { isProductionDeployment, PREVIEW_ROBOTS, PRODUCTION_ROBOTS } from '../lib/deployment';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
  imagePath?: string;
  pageType?: 'website' | 'article';
  schemaPageType?: 'WebPage' | 'AboutPage' | 'CollectionPage';
  extraStructuredData?: unknown[];
}

const {
  title,
  description = SITE_DESCRIPTION,
  imagePath = DEFAULT_OG_IMAGE,
  pageType = 'website',
  schemaPageType = 'WebPage',
  extraStructuredData = [],
} = Astro.props;

const canonicalUrl = getAbsoluteUrl(Astro.url.pathname, Astro.site);
const ogImageUrl = getAbsoluteUrl(imagePath, Astro.site);
const isProduction = isProductionDeployment();
const schema = [
  ...getMarketingPageSchemas({
    title,
    description,
    pathname: Astro.url.pathname,
    imagePath,
    pageType: schemaPageType,
  }),
  ...extraStructuredData,
];
---

<link rel="canonical" href={canonicalUrl} />
{isProduction && <link rel="sitemap" href={getAbsoluteUrl(withBase('sitemap-index.xml'), Astro.site)} />}
<meta name="robots" content={isProduction ? PRODUCTION_ROBOTS : PREVIEW_ROBOTS} />
<meta name="application-name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={pageType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:alt" content={`${SITE_NAME} preview`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={`${SITE_NAME} preview`} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
