---
interface ThemeFrame {
  src: string;
  alt: string;
  label: string;
}

interface Props {
  frames: ThemeFrame[];
  caption?: string;
}

const { frames, caption } = Astro.props;
const frameMilliseconds = 850;
// A frame the reel has not claimed yet still needs a src, because an img without one is
// invalid HTML. This transparent placeholder declares the same intrinsic size as the
// screenshots, so replacing it with the real file changes nothing about the layout.
// Decodes to <svg xmlns="http://www.w3.org/2000/svg" width="1700" height="1300"/>.
const PLACEHOLDER_FRAME =
  'data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxNzAwIiBoZWlnaHQ9IjEzMDAiLz4=';
---

<theme-reel>
  <figure
    class="media-shot theme-reel"
    data-theme-reel-interval={frameMilliseconds}
  >
    <div class="theme-reel-stage">
      {frames.map((frame, index) => (
        <div class:list={['theme-reel-frame', { 'is-active': index === 0 }]}>
          <img
            src={index === 0 ? frame.src : PLACEHOLDER_FRAME}
            data-theme-reel-src={index === 0 ? undefined : frame.src}
            alt={frame.alt}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
            width="1700"
            height="1300"
          />
          <span>{frame.label}</span>
        </div>
      ))}
    </div>
    {caption ? <figcaption>{caption}</figcaption> : null}
  </figure>
</theme-reel>

<script>
  class ThemeReel extends HTMLElement {
    connectedCallback() {
      const reel = this.querySelector<HTMLElement>('.theme-reel');
      if (!reel || this.dataset.themeReelState) return;

      // A reader who asked for less motion sees the first frame only, and is spared
      // the download of every other screenshot along with the animation.
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          this.start(reel);
        },
        { rootMargin: '200px' },
      );

      // The host element is display: contents so it stays out of the grid it sits in,
      // which also means it generates no box for the observer to measure. Watch the
      // figure instead.
      observer.observe(reel);

      // The first observation can be delivered before the reel has been laid out, and
      // an element that was already in view never reports a change afterwards. Check
      // the geometry once the page has settled so a reel above the fold still starts.
      const recheck = () => {
        if (this.dataset.themeReelState) return;
        const { top, bottom } = reel.getBoundingClientRect();
        if (bottom <= 0 || top >= window.innerHeight) return;
        observer.disconnect();
        this.start(reel);
      };

      if (document.readyState === 'complete') recheck();
      else window.addEventListener('load', recheck, { once: true });
    }

    start(reel: HTMLElement) {
      const frames = [...this.querySelectorAll<HTMLElement>('.theme-reel-frame')];
      if (frames.length < 2) return;

      const interval = Number.parseFloat(reel.dataset.themeReelInterval ?? '') || 850;
      let currentIndex = 0;
      this.dataset.themeReelState = 'running';

      const advance = async () => {
        const startedAt = performance.now();
        const nextIndex = (currentIndex + 1) % frames.length;
        const nextFrame = frames[nextIndex];
        const image = nextFrame.querySelector<HTMLImageElement>('img');

        if (!image) return;

        const source = image.dataset.themeReelSrc;
        if (source) {
          const placeholder = image.src;
          image.src = source;
          delete image.dataset.themeReelSrc;

          try {
            await image.decode();
          } catch {
            // Keep the current frame visible and retry this frame on the next turn.
            image.dataset.themeReelSrc = source;
            image.src = placeholder;
          }
        }

        const remaining = interval - (performance.now() - startedAt);
        if (remaining > 0) {
          await new Promise((resolve) => window.setTimeout(resolve, remaining));
        }

        if (!this.isConnected) return;
        if (image.dataset.themeReelSrc) {
          void advance();
          return;
        }

        frames[currentIndex].classList.remove('is-active');
        nextFrame.classList.add('is-active');
        currentIndex = nextIndex;
        void advance();
      };

      void advance();
    }
  }

  if (!customElements.get('theme-reel')) {
    customElements.define('theme-reel', ThemeReel);
  }
</script>

<style>
  theme-reel {
    display: contents;
  }
</style>
