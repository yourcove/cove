---
interface Props {
  src: string;
  originalSrc?: string;
  alt: string;
  caption?: string;
  variant?: 'default' | 'portrait';
}

const {
  src,
  originalSrc,
  alt,
  caption,
  variant = 'default',
} = Astro.props;
---

<figure class="media-shot" data-variant={variant}>
  <img src={src} alt={alt} loading="lazy" decoding="async" width="850" height="650" />
  {caption || originalSrc ? (
    <figcaption>
      {caption}
      {originalSrc ? <> <a href={originalSrc}>Open the full-size PNG.</a></> : null}
    </figcaption>
  ) : null}
</figure>
