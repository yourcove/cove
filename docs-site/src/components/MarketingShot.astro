---
interface Props {
  src: string;
  originalSrc?: string;
  alt: string;
  caption?: string;
  variant?: 'default' | 'portrait';
}

const {
  src,
  originalSrc,
  alt,
  caption,
  variant = 'default',
} = Astro.props;
---

<figure class="media-shot" data-variant={variant}>
  {originalSrc ? (
    <a class="media-shot-link" href={originalSrc} aria-label={`Open full-size image: ${alt}`}>
      <img src={src} alt={alt} loading="lazy" decoding="async" width="850" height="650" />
      <span class="media-shot-zoom" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-4-4"></path>
          <path d="M11 8v6M8 11h6"></path>
        </svg>
      </span>
    </a>
  ) : (
    <img src={src} alt={alt} loading="lazy" decoding="async" width="850" height="650" />
  )}
  {caption ? <figcaption>{caption}</figcaption> : null}
</figure>
