---
import DefaultHead from '@astrojs/starlight/components/Head.astro';
import manropeLatinUrl from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import { getDocPageSchema } from '../../lib/seo';

const { entry } = Astro.locals.starlightRoute;
const pageSchema = getDocPageSchema({
  title: entry.data.title,
  description: entry.data.description ?? '',
  pathname: Astro.url.pathname,
});
---

<DefaultHead />
<link rel="preload" href={manropeLatinUrl} as="font" type="font/woff2" crossorigin="anonymous" />
<script is:inline type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
