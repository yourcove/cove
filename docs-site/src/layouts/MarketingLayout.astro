---
import '../styles/global.css';
import CoveWordmark from '../components/CoveWordmark.astro';
import MarketingSeo from '../components/MarketingSeo.astro';
import { withBase } from '../lib/paths';
import { SITE_DESCRIPTION } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  imagePath?: string;
  pageType?: 'website' | 'article';
  schemaPageType?: 'WebPage' | 'AboutPage' | 'CollectionPage';
  extraStructuredData?: unknown[];
}

const {
  title = 'Cove',
  description = SITE_DESCRIPTION,
  imagePath,
  pageType = 'website',
  schemaPageType = 'WebPage',
  extraStructuredData = [],
} = Astro.props;

const pageTitle = title === 'Cove' ? 'Cove' : `${title} | Cove`;
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/features/', label: 'Features' },
  { href: '/download/', label: 'Download' },
  { href: '/screenshots/', label: 'Screenshots' },
  { href: '/docs/', label: 'Docs' },
  { href: '/about/', label: 'About' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={withBase('favicon.svg')} />
    <MarketingSeo
      title={pageTitle}
      description={description}
      imagePath={imagePath}
      pageType={pageType}
      schemaPageType={schemaPageType}
      extraStructuredData={extraStructuredData}
    />
  </head>
  <body class="marketing-body">
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand-lockup" href={withBase('')} aria-label="Cove home">
          <span class="sr-only">Cove</span>
          <CoveWordmark class="brand-wordmark" />
          <span class="brand-tagline">Content Organization for Virtual Entertainment</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          {navItems.map((item) => {
            const href = withBase(item.href);
            const isCurrent = currentPath === href || currentPath === href.slice(0, -1);
            return <a href={href} data-current={isCurrent ? 'true' : 'false'}>{item.label}</a>;
          })}
        </nav>
      </div>
    </header>

    <main class="page-shell">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <div>
          <span class="sr-only">Cove</span>
          <CoveWordmark class="brand-wordmark brand-wordmark-footer" />
          <p>Free, open-source media organization for serious personal libraries. Your data stays on your system.</p>
        </div>
        <div class="footer-links">
          <a href={withBase('download/')}>Download</a>
          <a href={withBase('docs/')}>Docs</a>
          <a href={withBase('local-media-organizer/')}>Local Media Organizer</a>
          <a href={withBase('faq/')}>FAQ</a>
          <a href={withBase('privacy/')}>Privacy</a>
          <a href="https://github.com/yourcove/cove">GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>
