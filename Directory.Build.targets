<Project>
  <!--
    Cove versioning.

    Single source of truth for the product version is the git tag (e.g. v0.0.36).

      * Tagged release builds: CI passes -p:Version=0.0.36 -p:CoveCiVersion=true,
        so that exact version is baked into the assemblies.
      * Local / dev builds (no explicit version): the version is derived from git as
        "<next patch>-dev.<commit distance>" (e.g. two commits after v0.0.35 =>
        0.0.36-dev.2). With no tags or no git available it falls back to 0.0.0-dev.0.

    The numeric major.minor.patch (AssemblyVersion / FileVersion) never carries the
    prerelease suffix. The full string (including -dev.N) is exposed through
    AssemblyInformationalVersion and is used for display and extension host-compatibility
    checks.

    This target is skipped when an explicit non-default Version is supplied (CI / Docker
    pass -p:Version=...), so it only affects local/dev builds.
  -->
  <Target Name="SetCoveVersionFromGit"
          BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;BeforeCompile;CoreCompile;Pack;GenerateNuspec"
          Condition=" '$(CoveCiVersion)' != 'true' and ( '$(Version)' == '' or '$(Version)' == '1.0.0' ) ">

    <!-- Exact tag on the current commit (a release checkout). -->
    <Exec Command="git describe --tags --exact-match --match &quot;v[0-9]*.[0-9]*.[0-9]*&quot;"
          ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_CoveExactTag" />
      <Output TaskParameter="ExitCode" PropertyName="_CoveExactExit" />
    </Exec>

    <PropertyGroup>
      <_CoveCoreTagPattern>v(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)</_CoveCoreTagPattern>
      <_CoveExactTag>$(_CoveExactTag.Trim())</_CoveExactTag>
      <_CoveExactTagValid>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_CoveExactTag)', '^(?!$(_CoveCoreTagPattern)-dev(?:\.|$))(?!$(_CoveCoreTagPattern)-(?:[0-9A-Za-z-]+\.)*0[0-9]+(?:\.|$))$(_CoveCoreTagPattern)(?:-[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$'))</_CoveExactTagValid>
    </PropertyGroup>

    <!-- Otherwise, the most recent tag reachable from HEAD (a dev checkout). -->
    <Exec Condition=" '$(_CoveExactExit)' != '0' or '$(_CoveExactTagValid)' != 'true' "
          Command="git describe --tags --abbrev=0 --match &quot;v[0-9]*.[0-9]*.[0-9]*&quot; --exclude &quot;*-*&quot;"
          ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_CoveLatestTag" />
      <Output TaskParameter="ExitCode" PropertyName="_CoveLatestExit" />
    </Exec>

    <PropertyGroup>
      <_CoveLatestTag>$(_CoveLatestTag.Trim())</_CoveLatestTag>
      <_CoveLatestTagValid>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_CoveLatestTag)', '^$(_CoveCoreTagPattern)$'))</_CoveLatestTagValid>
    </PropertyGroup>

    <!-- A monotonically increasing identity within the line that follows the latest stable release. -->
    <Exec Condition=" ( '$(_CoveExactExit)' != '0' or '$(_CoveExactTagValid)' != 'true' ) and '$(_CoveLatestExit)' == '0' and '$(_CoveLatestTagValid)' == 'true' "
          Command="git rev-list --count &quot;$(_CoveLatestTag)..HEAD&quot;"
          ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_CoveCommitDistance" />
      <Output TaskParameter="ExitCode" PropertyName="_CoveCommitDistanceExit" />
    </Exec>

    <PropertyGroup>
      <!-- Normalize: trim whitespace and a leading "v". -->
      <_CoveExactVersion>$(_CoveExactTag.TrimStart('v'))</_CoveExactVersion>
      <_CoveLatestVersion>$(_CoveLatestTag.TrimStart('v'))</_CoveLatestVersion>
      <_CoveCommitDistance>$(_CoveCommitDistance.Trim())</_CoveCommitDistance>
      <_CoveLatestMajor Condition=" '$(_CoveLatestTagValid)' == 'true' ">$([System.Version]::Parse('$(_CoveLatestVersion)').Major)</_CoveLatestMajor>
      <_CoveLatestMinor Condition=" '$(_CoveLatestTagValid)' == 'true' ">$([System.Version]::Parse('$(_CoveLatestVersion)').Minor)</_CoveLatestMinor>
      <_CoveNextPatch Condition=" '$(_CoveLatestTagValid)' == 'true' ">$([MSBuild]::Add('$([System.Version]::Parse('$(_CoveLatestVersion)').Build)', '1'))</_CoveNextPatch>
      <_CoveDevelopmentBase Condition=" '$(_CoveNextPatch)' != '' ">$(_CoveLatestMajor).$(_CoveLatestMinor).$(_CoveNextPatch)</_CoveDevelopmentBase>

      <Version Condition=" '$(_CoveExactExit)' == '0' and '$(_CoveExactTagValid)' == 'true' ">$(_CoveExactVersion)</Version>
      <Version Condition=" ( '$(_CoveExactExit)' != '0' or '$(_CoveExactTagValid)' != 'true' ) and '$(_CoveLatestExit)' == '0' and '$(_CoveCommitDistanceExit)' == '0' and '$(_CoveDevelopmentBase)' != '' and '$(_CoveCommitDistance)' != '' ">$(_CoveDevelopmentBase)-dev.$(_CoveCommitDistance)</Version>
      <Version Condition=" ( '$(_CoveExactExit)' != '0' or '$(_CoveExactTagValid)' != 'true' ) and '$(_CoveLatestExit)' == '0' and '$(_CoveDevelopmentBase)' != '' and '$(Version)' == '' ">$(_CoveDevelopmentBase)-dev.0</Version>
    </PropertyGroup>

    <!-- Fallback when git / tags are unavailable. -->
    <PropertyGroup Condition=" ( '$(Version)' == '' ) ">
      <Version>0.0.0-dev.0</Version>
    </PropertyGroup>

    <!--
      The SDK captures InformationalVersion's default ($(Version)) very early, so we must
      set the version-derived attributes explicitly here rather than rely on those defaults.
    -->
    <PropertyGroup>
      <_CoveNumericVersion>$(Version.Split('-')[0])</_CoveNumericVersion>
      <AssemblyVersion>$(_CoveNumericVersion)</AssemblyVersion>
      <FileVersion>$(_CoveNumericVersion)</FileVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
      <PackageVersion>$(Version)</PackageVersion>
    </PropertyGroup>

    <Message Importance="high" Text="Cove version: $(Version) (assembly $(AssemblyVersion))" />
  </Target>

</Project>
