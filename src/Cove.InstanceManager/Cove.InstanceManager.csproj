<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Windows executable icon (Cove.InstanceManager.exe). Shared Cove logo lives at the repo root. -->
    <ApplicationIcon>..\..\coveicon.ico</ApplicationIcon>
    <!-- GUI subsystem so launching the manager (shortcut, startup script, double-click) does not pop a
         console/terminal window. When run from an existing terminal it re-attaches to the parent console
         (see NativeConsole.AttachToParentConsole) so CLI output and the help text still appear. -->
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cove.Tests" />
  </ItemGroup>

  <!--
    Child processes take their arguments as a list (ProcessStartInfo.ArgumentList), never as one
    command-line string, so a path can never be split into extra arguments. See BannedSymbols.txt.
  -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cove.Core\Cove.Core.csproj" />
  </ItemGroup>

</Project>