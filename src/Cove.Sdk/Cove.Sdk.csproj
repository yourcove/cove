<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cove.Plugins\Cove.Plugins.csproj" />
  </ItemGroup>

  <!-- Ship the extension packaging rules inside the package so every consumer (including third-party
       extensions) automatically compiles against the host contracts without bundling the host's runtime
       assemblies. buildTransitive/ flows to both direct and indirect referencers. -->
  <ItemGroup>
    <None Include="buildTransitive\Cove.Sdk.targets" Pack="true" PackagePath="buildTransitive\Cove.Sdk.targets" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Cove.Sdk</PackageId>
    <Title>Cove Extension SDK</Title>
    <Description>SDK for building Cove extensions. Provides base classes, helpers, and patterns for extending the Cove media organizer.</Description>
    <Authors>Cove</Authors>
    <RepositoryUrl>https://github.com/yourcove/cove</RepositoryUrl>
    <PackageProjectUrl>https://github.com/yourcove/cove</PackageProjectUrl>
    <PackageTags>cove;sdk;extensions;plugins</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
