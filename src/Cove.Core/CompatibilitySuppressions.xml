<?xml version="1.0" encoding="utf-8"?>
<!-- https://learn.microsoft.com/dotnet/fundamentals/package-validation/diagnostic-ids -->
<Suppressions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <!--
    Deliberately accepted break, listed as a breaking change in CHANGELOG.md under the release that
    follows 1.4.1. Multi-country performer filtering typed PerformerFilter.CountryCriterion as
    CountryCriterion instead of StringCriterion, so an extension compiled against 1.4.x that reads or
    sets the property must be rebuilt. Remove this entry when CoveExtensionAbiBaselineVersion is bumped
    past that release.
  -->
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Cove.Core.Interfaces.PerformerFilter.get_CountryCriterion</Target>
  </Suppression>

  <!--
    Deliberately accepted break, listed as a breaking change in CHANGELOG.md under the release that
    follows 1.4.1. The in-process ("managed") frame extractor was removed: batching the ffmpeg process
    path made it faster than in-process decoding, and a fault in the native decoder could take the whole
    host down, which it repeatedly did. FrameExtractionMode selected between the two, so with only one
    path left the setting no longer means anything and has been removed rather than left as an
    ignored property. Remove these entries when CoveExtensionAbiBaselineVersion is bumped past that
    release.
  -->
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Cove.Core.Interfaces.CoveConfiguration.get_FrameExtractionMode</Target>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Cove.Core.Interfaces.CoveConfiguration.set_FrameExtractionMode(System.String)</Target>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Cove.Core.DTOs.CoveConfigDto.get_FrameExtractionMode</Target>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Cove.Core.DTOs.CoveConfigDto.set_FrameExtractionMode(System.String)</Target>
  </Suppression>

  <!--
    Deliberately accepted break, listed as a breaking change in CHANGELOG.md under the release that
    follows 1.5.1. Segment thumbnails and animated segment previews are no longer generated: nothing
    displayed the animated previews, segment cards show a sprite-sheet frame (or a cover set by hand),
    and pre-generating an asset per segment made Generate walk the whole library. The generate options
    and the stream service's animated-preview lookup were removed rather than left as ignored members;
    no known extension used them. Remove these entries when CoveExtensionAbiBaselineVersion is bumped
    past that release.
  -->
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Cove.Core.Interfaces.IStreamService.GetSegmentAnimatedPreview(System.Int32,System.Double,System.Threading.CancellationToken)</Target>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Cove.Core.DTOs.GenerateOptionsDto.get_Segments</Target>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Cove.Core.DTOs.GenerateOptionsDto.set_Segments(System.Boolean)</Target>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Cove.Core.DTOs.GenerateOptionsDto.get_SegmentThumbnails</Target>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Cove.Core.DTOs.GenerateOptionsDto.set_SegmentThumbnails(System.Boolean)</Target>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Cove.Core.DTOs.GenerateOptionsDto.get_SegmentPreviews</Target>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Cove.Core.DTOs.GenerateOptionsDto.set_SegmentPreviews(System.Boolean)</Target>
  </Suppression>
</Suppressions>
