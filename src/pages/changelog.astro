---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout title="Changelog" description="Current website milestones and future release-feed integration plan.">
  <section class="marketing-section">
    <div class="marketing-section-inner">
      <p class="eyebrow-small">Changelog</p>
      <h1 class="page-heading">Release notes</h1>
      <p class="page-copy">Highlights from Cove releases. Full release artifacts and source changes live in GitHub Releases.</p>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner info-grid">
      <article class="info-card"><h3>Cove 1.0</h3><p>General release with full library organization, search, permissions, themes, extension support, and user/developer documentation.</p></article>
      <article class="info-card"><h3>Media model complete</h3><p>Scenes, images, galleries, audio, text, segments, sub-scenes, and virtual compilations share one organization model.</p></article>
      <article class="info-card"><h3>Administration ready</h3><p>Users, groups, roles, content rules, share links, API tokens, audit history, backups, and upgrade guidance are documented.</p></article>
    </div>
  </section>
</MarketingLayout>
