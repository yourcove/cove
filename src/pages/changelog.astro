---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout title="Changelog" description="Current website milestones and future release-feed integration plan.">
  <section class="marketing-section">
    <div class="marketing-section-inner">
      <p class="eyebrow-small">Changelog</p>
      <h1 class="page-heading">Release notes and milestones</h1>
      <p class="page-copy">This page is ready for GitHub Releases integration later. For now it shows a stable public structure and placeholder content.</p>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner info-grid">
      <article class="info-card"><h3>Site scaffold started</h3><p>Initial Astro + Starlight structure, GitHub Pages workflow, and docs split.</p></article>
      <article class="info-card"><h3>Docs split defined</h3><p>User Docs and Developer Docs now have separate URLs and sidebar groups.</p></article>
      <article class="info-card"><h3>Placeholder media ready</h3><p>Screenshot and demo slots are ready for a safe demo library.</p></article>
    </div>
  </section>
</MarketingLayout>
