---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { COVE_RELEASES, COVE_RELEASES_LATEST } from '../lib/site';
---

<MarketingLayout
  title="Cove Changelog"
  description="Where to find Cove releases, downloads, and version history."
>
  <section class="marketing-section">
    <div class="marketing-section-inner">
      <p class="eyebrow-small">Changelog</p>
      <h1 class="page-heading">Releases and version history</h1>
      <p class="page-copy">
        Every version of Cove is published on GitHub with downloads and release notes. If you're new, just grab the latest release.
      </p>
      <div class="button-row">
        <a class="button" href={COVE_RELEASES_LATEST}>Latest release</a>
        <a class="button-ghost" href={COVE_RELEASES}>All releases</a>
      </div>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner info-grid">
      <article class="info-card">
        <h3>Upgrades are safe</h3>
        <p>Cove backs up your library before applying any update, so moving to a new version doesn't put your data at risk.</p>
      </article>
      <article class="info-card">
        <h3>Stable and preview builds</h3>
        <p>Stable releases are the default. Prerelease builds are published on the same page if you want new features early.</p>
      </article>
      <article class="info-card">
        <h3>Full history</h3>
        <p><a href={COVE_RELEASES}>GitHub Releases</a> holds the downloads and notes for every version that has shipped.</p>
      </article>
    </div>
  </section>
</MarketingLayout>
