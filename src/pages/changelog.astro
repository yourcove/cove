---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { COVE_RELEASES, COVE_RELEASES_LATEST } from '../lib/site';
---

<MarketingLayout title="Changelog" description="Where to find Cove's releases, downloads, and version history.">
  <section class="marketing-section">
    <div class="marketing-section-inner">
      <p class="eyebrow-small">Changelog</p>
      <h1 class="page-heading">Releases and version history</h1>
      <p class="page-copy">
        Every version of Cove is published on GitHub with its downloads and notes. The latest release is the best place to start; the full history covers everything that came before.
      </p>
      <div class="button-row">
        <a class="button" href={COVE_RELEASES_LATEST}>Latest release</a>
        <a class="button-ghost" href={COVE_RELEASES}>All releases</a>
      </div>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner info-grid">
      <article class="info-card">
        <h3>Current website milestone</h3>
        <p>The site now covers marketing pages, user docs, and developer docs as separate surfaces instead of one blended overview.</p>
      </article>
      <article class="info-card">
        <h3>Current product focus</h3>
        <p>Installation, search, organization, sharing, metadata tools, and extensibility are the main public product stories being documented here.</p>
      </article>
      <article class="info-card">
        <h3>Where detailed release history lives</h3>
        <p><a href={COVE_RELEASES}>GitHub Releases</a> holds the downloads and notes for every version. A summarized feed will be wired into this page in a later update.</p>
      </article>
    </div>
  </section>
</MarketingLayout>
