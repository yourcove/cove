---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout title="About" description="About Cove and the goals behind the public site.">
  <section class="marketing-section">
    <div class="marketing-section-inner two-column">
      <div>
        <p class="eyebrow-small">About Cove</p>
        <h1 class="page-heading">Cove</h1>
        <p class="lead">Content Organization for Virtual Entertainment. Cove is being built as a fast, extensible media organizer that can stay practical for daily use while still supporting deeper workflows.</p>
      </div>
      <div class="panel">
        <h3>What this site is for</h3>
        <p>Show the product clearly, keep the docs split clean, and ship quickly on GitHub Pages before any future hosting move.</p>
      </div>
    </div>
  </section>
</MarketingLayout>
