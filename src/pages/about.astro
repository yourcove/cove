---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout title="About" description="About Cove and the goals behind the public site.">
  <section class="marketing-section">
    <div class="marketing-section-inner two-column">
      <div>
        <p class="eyebrow-small">About Cove</p>
        <h1 class="page-heading">Cove</h1>
        <p class="lead">Content Organization for Virtual Entertainment. Cove is a free, open-source media organizer for people who want a serious library without giving up control of their data or their workflow.</p>
      </div>
      <div class="panel">
        <h3>What Cove is for</h3>
        <p>Cove helps you organize large personal media libraries, understand where metadata came from, search quickly, manage access, and customize the interface without relying on a hosted account.</p>
      </div>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner info-grid">
      <article class="info-card"><h3>Free, Open Source Forever</h3><p>Cove is built as open software people can run, inspect, and improve.</p></article>
      <article class="info-card"><h3>Local control</h3><p>Your library, accounts, generated media, and metadata stay on the machine or server you operate.</p></article>
      <article class="info-card"><h3>Extensible by design</h3><p>Extensions can add workflows, pages, jobs, metadata, themes, and integrations while respecting host permissions.</p></article>
    </div>
  </section>
</MarketingLayout>
