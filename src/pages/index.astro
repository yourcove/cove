---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PlaceholderMedia from '../components/PlaceholderMedia.astro';
import { withBase } from '../lib/paths';
---

<MarketingLayout title="Cove" description="Cove is a free, open-source local media organizer that starts simple and scales into a serious personal library.">
  <section class="hero">
    <div>
      <div class="eyebrow">Content Organization for Virtual Entertainment</div>
      <h1>Cove</h1>
      <p class="lead">A local media library that grows with you. Start with a folder, then go as deep — or stay as simple — as you want.</p>
      <div class="pill-row">
        <span class="pill">Free, Open Source Forever</span>
        <span class="pill">Your data stays on your system</span>
        <span class="pill">Docker or native install</span>
        <span class="pill">Import existing libraries</span>
      </div>
      <div class="button-row">
        <a class="button" href={withBase('download/')}>Download Cove</a>
        <a class="button-ghost" href={withBase('features/')}>Explore features</a>
        <a class="button-ghost" href={withBase('screenshots/')}>View screenshots</a>
      </div>
      <div class="trust-row">
        <span class="trust-item">No account required.</span>
        <span class="trust-item">Runs on hardware you already own.</span>
        <span class="trust-item">Built to keep up as your library grows.</span>
      </div>
    </div>
    <PlaceholderMedia label="Cove library command center" caption="Dashboard, saved views, recent activity, and library health in one place." />
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner">
      <p class="section-kicker">Two good ways to begin</p>
      <h2 class="section-heading">Whether this is your first library or your fifth, Cove meets you where you are.</h2>
      <div class="audience-grid">
        <article class="audience-card">
          <h3>New to local organization</h3>
          <p>Point Cove at a folder, scan your first collection, and start browsing. The deeper features are there when you want them — not in the way when you don't.</p>
          <ul class="check-list">
            <li>Docker or native builds for easy installation.</li>
            <li>Guided first steps for scanning and basic metadata.</li>
            <li>One library that grows with you instead of one you outgrow.</li>
          </ul>
          <a class="button-ghost" href={withBase('download/')}>Get started</a>
        </article>
        <article class="audience-card">
          <h3>Already running a local library</h3>
          <p>Bring your existing collection across and pick up the pieces a single-user organizer can't give you: real users and groups, a record of where each piece of metadata came from, and extensions that reach all the way through the app.</p>
          <ul class="check-list">
            <li>Importer for existing libraries and their metadata.</li>
            <li>Multi-user accounts with roles, content rules, share links, and audit history.</li>
            <li>Segments, dynamic groups, custom fields, and broader media types in one model.</li>
          </ul>
          <a class="button-ghost" href={withBase('features/')}>See what's different</a>
        </article>
      </div>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner proof-grid">
      <article class="proof-card"><strong>1</strong><span>command to install — Docker all-in-one or a native build.</span></article>
      <article class="proof-card"><strong>5</strong><span>first-class media kinds: scenes, images, galleries, audio, and text.</span></article>
      <article class="proof-card"><strong>19</strong><span>built-in themes, plus custom colors and layout preferences.</span></article>
      <article class="proof-card"><strong>100%</strong><span>of your library lives on hardware you control.</span></article>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner">
      <p class="section-kicker">Why people stay</p>
      <h2 class="section-heading">Cove stays simple when your library is small and keeps up when it isn't.</h2>
      <div class="feature-grid">
      <article class="feature-card">
        <h3>Search that understands the library</h3>
        <p>Find media by title, description, paths, tags, performers, studios, groups, aliases, and saved criteria — not just filenames.</p>
      </article>
      <article class="feature-card">
        <h3>Metadata you can trust</h3>
        <p>Every tag, field, and edit keeps a record of where it came from. Review changes before they land, and roll one back without losing the rest.</p>
      </article>
      <article class="feature-card">
        <h3>Real users, not a shared password</h3>
        <p>Add users and groups with roles, content rules, share links, API tokens, and audit history — so a household, a small team, or a friend can use the library without stepping on each other.</p>
      </article>
      <article class="feature-card">
        <h3>Segments as first-class citizens</h3>
        <p>Mark sub-scenes, tag time ranges, generate previews, and build virtual compilations without duplicating files.</p>
      </article>
      <article class="feature-card">
        <h3>Extensions that reach the whole app</h3>
        <p>One extension system covers UI pages, tabs, dialogs, APIs, background jobs, events, settings, persistent data, and themes.</p>
      </article>
      <article class="feature-card">
        <h3>Built to keep up</h3>
        <p>PostgreSQL-backed search, job progress, and explicit performance targets keep large collections usable instead of sluggish.</p>
      </article>
      </div>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner two-column">
      <div class="panel">
        <p class="section-kicker">Yours, end to end</p>
        <h3>Your library stays on your system.</h3>
        <p>Cove runs on the machine or server you choose. You decide who can access it, which providers and downloaders to connect, and which extensions get to run — nothing leaves your network unless you ask it to.</p>
        <ul class="check-list">
          <li>No account required.</li>
          <li>Your files, metadata, and generated previews stay local.</li>
          <li>Free, Open Source Forever.</li>
        </ul>
      </div>
      <PlaceholderMedia label="Users, roles, and permissions" caption="User management, content rules, share links, API tokens, and audit history." />
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner">
      <p class="section-kicker">Things you'll notice quickly</p>
      <h2 class="section-heading">A handful of small things that add up to a library you actually want to keep using.</h2>
      <div class="comparison-grid">
        <article class="comparison-card">
          <span class="before">More than video</span>
          <span class="after">Scenes, images, galleries, audio, text, faces, segments, and groups all live in the same library.</span>
        </article>
        <article class="comparison-card">
          <span class="before">A record of every change</span>
          <span class="after">Each field remembers which scraper, import, edit, or extension set it — so you can review, undo, or re-run with context.</span>
        </article>
        <article class="comparison-card">
          <span class="before">A library for more than one person</span>
          <span class="after">Users, groups, and roles let a household or small team share one library without sharing one password.</span>
        </article>
        <article class="comparison-card">
          <span class="before">Extensions that don't feel bolted on</span>
          <span class="after">Add UI pages, background jobs, APIs, settings, themes, and stored data through a single, first-class extension system.</span>
        </article>
      </div>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner doc-split-grid">
      <article class="doc-track-card">
        <h3>Ready to install?</h3>
        <p>Use Docker all-in-one, a native release, or source builds depending on how you like to run local software.</p>
        <a class="button-ghost" href={withBase('download/')}>Download Cove</a>
      </article>
      <article class="doc-track-card">
        <h3>Want details first?</h3>
        <p>Read the user docs for installation and day-to-day workflows, or the developer docs for extension building.</p>
        <a class="button-ghost" href={withBase('docs/')}>Open docs</a>
      </article>
    </div>
  </section>
</MarketingLayout>
