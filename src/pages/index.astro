---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PlaceholderMedia from '../components/PlaceholderMedia.astro';
import { withBase } from '../lib/paths';
---

<MarketingLayout title="Cove" description="Content Organization for Virtual Entertainment. A fast, extensible media organizer for serious personal libraries.">
  <section class="hero">
    <div>
      <div class="eyebrow">Content Organization for Virtual Entertainment</div>
      <h1>Cove</h1>
      <p class="lead">A free, open-source media organizer for serious personal libraries. Cove keeps scenes, images, galleries, audio, and text organized with fast search, rich metadata, permissions, and an interface you can make your own.</p>
      <div class="pill-row">
        <span class="pill">Free, Open Source Forever</span>
        <span class="pill">Your data stays on your system</span>
        <span class="pill">19 built-in themes</span>
        <span class="pill">Full search</span>
      </div>
      <div class="button-row">
        <a class="button" href={withBase('download/')}>Download Cove</a>
        <a class="button-ghost" href={withBase('docs/')}>Read the docs</a>
        <a class="button-ghost" href={withBase('screenshots/')}>View screenshots</a>
      </div>
      <div class="trust-row">
        <span class="trust-item">No telemetry.</span>
        <span class="trust-item">No hosted account required.</span>
      </div>
    </div>
    <PlaceholderMedia label="Cove library dashboard" caption="Demo-library capture coming soon." />
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner">
      <p class="section-kicker">What makes Cove different</p>
      <h2 class="section-heading">A library model that can keep up with the way people actually organize media.</h2>
      <p class="section-copy">Cove is built for large, evolving collections: scenes, images, galleries, audio, text, performers, studios, tags, saved filters, generated media, backups, watch workflows, and metadata provenance that stays understandable.</p>
      <div class="feature-grid">
        <article class="feature-card">
          <h3>Media without silos</h3>
          <p>Work with scenes, images, galleries, audio, text, performers, studios, tags, groups, and sub-scenes from one coherent library.</p>
        </article>
        <article class="feature-card">
          <h3>Find it fast</h3>
          <p>Use full search, filters, saved filters, dynamic groups, and keyboard-friendly pages built for collections that outgrow memory.</p>
        </article>
        <article class="feature-card">
          <h3>Customize the whole feel</h3>
          <p>Choose from 19 built-in themes, tune colors and component styles, and add extension-powered workflows that still feel native.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner two-column">
      <div class="panel">
        <p class="section-kicker">Built for real use</p>
        <h3>Your library stays on your system.</h3>
        <p>Cove does not send telemetry or library data to Cove servers. Run it on the machine or server you control, then decide who can access it with users, groups, roles, permissions, share links, API tokens, audit history, and content rules.</p>
      </div>
      <PlaceholderMedia label="Users, roles, and permissions" caption="Demo-library capture coming soon." />
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner feature-grid">
      <article class="feature-card">
        <h3>Sub-scenes and virtual compilations</h3>
        <p>Mark meaningful spans inside media, reuse them without duplicating files, and build compilations that stay tied to their source material.</p>
      </article>
      <article class="feature-card">
        <h3>Understandable provenance</h3>
        <p>See where metadata came from, what changed, and which source contributed it so automated organization never becomes a black box.</p>
      </article>
      <article class="feature-card">
        <h3>Facial recognition support</h3>
        <p>Use optional AI workflows for face detection, identity suggestions, and appearance review while keeping the resulting data in your Cove library.</p>
      </article>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner">
      <p class="section-kicker">Learn more</p>
      <h2 class="section-heading">Go straight to the docs that match what you are doing.</h2>
      <div class="doc-split-grid">
        <article class="doc-track-card">
          <h3>User Docs</h3>
          <p>Installation, first scan, organizing, search, permissions, backups, and troubleshooting for running Cove day to day.</p>
          <a class="button-ghost" href={withBase('docs/user/')}>Open User Docs</a>
        </article>
        <article class="doc-track-card">
          <h3>Developer Docs</h3>
          <p>Extension architecture, packaging, permissions, APIs, and contribution notes for builders working on top of Cove.</p>
          <a class="button-ghost" href={withBase('docs/developer/')}>Open Developer Docs</a>
        </article>
      </div>
    </div>
  </section>
</MarketingLayout>
