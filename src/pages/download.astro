---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout title="Download" description="Install Cove with Docker, native downloads, or from source.">
  <section class="marketing-section">
    <div class="marketing-section-inner">
      <p class="eyebrow-small">Install</p>
      <h1 class="page-heading">Download and install</h1>
      <p class="page-copy">Keep the first public path simple. Recommend Docker all-in-one first, then offer native downloads and source builds for advanced users.</p>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner two-column">
      <div class="panel">
        <h3>Docker all-in-one</h3>
        <div class="code-block"><pre><code>cd docker&#10;docker compose -f docker-compose.allinone.yml up -d</code></pre></div>
      </div>
      <div class="panel">
        <h3>Native downloads placeholder</h3>
        <p>Replace this with real Windows, macOS, and Linux release cards once public artifacts are available.</p>
      </div>
    </div>
  </section>
</MarketingLayout>
