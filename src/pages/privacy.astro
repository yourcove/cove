---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout title="Privacy" description="Privacy notes for Cove, the public website, and future optional services.">
  <section class="marketing-section">
    <div class="marketing-section-inner">
      <p class="eyebrow-small">Privacy</p>
      <h1 class="page-heading">Privacy notes</h1>
      <p class="page-copy">Keep the privacy story simple and accurate. The app is local-first, the website ships without analytics by default, and optional future services must be disclosed clearly before they go live.</p>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner info-grid">
      <article class="info-card"><h3>Cove app</h3><p>No telemetry by default. Your library stays local unless you deliberately connect outside services.</p></article>
      <article class="info-card"><h3>This website</h3><p>No analytics by default in this first pass.</p></article>
      <article class="info-card"><h3>Future optional services</h3><p>Any future social or registry-adjacent service should be documented separately when it actually exists.</p></article>
    </div>
  </section>
</MarketingLayout>
