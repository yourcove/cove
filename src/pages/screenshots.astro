---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PlaceholderMedia from '../components/PlaceholderMedia.astro';
---

<MarketingLayout title="Screenshots" description="Placeholder screenshot and demo media plan for Cove.">
  <section class="marketing-section">
    <div class="marketing-section-inner">
      <p class="eyebrow-small">Visual tour</p>
      <h1 class="page-heading">Screenshots and demo media</h1>
      <p class="page-copy">These placeholders mark the captures the site needs. Swap them for safe demo-library media only.</p>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner screenshot-grid">
      <PlaceholderMedia label="Home dashboard" />
      <PlaceholderMedia label="Scene detail and timeline" />
      <PlaceholderMedia label="Search and filters" />
      <PlaceholderMedia label="Themes and customization" />
    </div>
  </section>
</MarketingLayout>
