---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PlaceholderMedia from '../components/PlaceholderMedia.astro';
---

<MarketingLayout title="Screenshots" description="Screenshot and demo media tour for Cove.">
  <section class="marketing-section">
    <div class="marketing-section-inner">
      <p class="eyebrow-small">Visual tour</p>
      <h1 class="page-heading">Screenshots</h1>
      <p class="page-copy">A quick tour of the main Cove surfaces. Safe public demo-library captures will fill these slots as the demo library is prepared.</p>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section-inner screenshot-grid">
      <PlaceholderMedia label="Home dashboard" caption="Library status, recent activity, saved workflows, and quick entry points." />
      <PlaceholderMedia label="Scene detail and timeline" caption="Metadata, generated media, span review, and related organization in one place." />
      <PlaceholderMedia label="Search and filters" caption="Full search, saved filters, and large-library browsing controls." />
      <PlaceholderMedia label="Themes and customization" caption="Theme selection, custom colors, and UI style controls." />
      <PlaceholderMedia label="Users and permissions" caption="Roles, content rules, share links, API tokens, and audit history." />
      <PlaceholderMedia label="Extensions and jobs" caption="Native-feeling extension pages, settings, background tasks, and contributed UI." />
    </div>
  </section>
</MarketingLayout>
