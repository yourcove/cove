{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cove": {
    "CovePaths": [],
    "Host": "0.0.0.0",
    "Port": 5073,
    "MaxConcurrentDownloads": 3,
    "CalculateMd5": false,
    "Auth": {
      "Enabled": false,
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 30,
      "AllowAnonymousShareLinks": true,
      "EnforceDefaultDeny": true,
      "KnownProxies": [],
      "TrustedHosts": []
    },
    "Postgres": {
      "Managed": true,
      "Port": 5433,
      "Database": "cove"
    }
  }
}
